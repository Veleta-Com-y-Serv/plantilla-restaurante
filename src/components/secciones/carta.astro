---
// Carta: platos agrupados por `categoria` (en el orden en que aparecen), nombre … precio con línea de puntos,
// marca «de la casa» en los `destacado: true` (el texto de la marca se cambia con `marca_destacado`).
// Sin precio no hay puntos ni cifra. Bloque aparte opcional `menu_dia: {titulo, precio, texto}` (una línea por plato)
// y foto opcional (`imagen`). A dos columnas en escritorio.
import { seccion, agrupar, lineas } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const grupos = s ? agrupar(s.platos, (p) => p.categoria) : [];
const marca = (s?.marca_destacado as string | undefined)?.trim() || 'De la casa';
const m = s?.menu_dia;
---

{
  s && (
    <Seccion id={Astro.props.id} class="carta">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {(m || s.imagen) && (
        <div class:list={['carta-cabeza', { 'carta-cabeza--doble': m && s.imagen }]}>
          {s.imagen && <Imagen src={s.imagen} alt={altSeccion(s)} ancho={1200} alto={900} class="carta-foto" />}
          {m && (
            <div class="menu-dia">
              {m.titulo && <h3 class="menu-dia-titulo">{m.titulo}</h3>}
              {m.precio && <p class="menu-dia-precio">{m.precio}</p>}
              {lineas(m.texto).length > 0 && (
                <ul class="menu-dia-lineas">
                  {lineas(m.texto).map((l) => <li>{l}</li>)}
                </ul>
              )}
            </div>
          )}
        </div>
      )}
      {grupos.length > 0 && (
        <div class="carta-columnas">
          {grupos.map((g) => (
            <section class="carta-grupo" aria-label={g.grupo || undefined}>
              {g.grupo && <h3 class="carta-categoria">{g.grupo}</h3>}
              <ul>
                {g.items.map((p) => (
                  <li class="plato">
                    <p class="plato-linea">
                      <span class="plato-nombre">{p.nombre}</span>
                      {p.precio && (
                        <>
                          <span class="plato-puntos" aria-hidden="true" />
                          <span class="plato-precio">{p.precio}</span>
                        </>
                      )}
                    </p>
                    {p.destacado && (
                      <p class="plato-marca">
                        <Icono nombre="estrella" tam={13} class="fill-current" /> {marca}
                      </p>
                    )}
                    {p.texto && <p class="plato-texto">{p.texto}</p>}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      )}
      {s.cta?.url && (
        <p class="mt-12 text-center">
          <a class="btn" href={s.cta.url}>{s.cta.texto}</a>
        </p>
      )}
    </Seccion>
  )
}
