---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="contenedor py-24 text-center md:py-32">
    <p class="error-cifra" aria-hidden="true">404</p>
    <div class="titular titular--centro mt-6">
      <p class="antetitulo">Página no encontrada</p>
      <h1 class="titulo-seccion">Esta mesa no existe</h1>
      <p class="titular-texto">Puede que el enlace esté mal o que la página se haya movido.</p>
    </div>
    <p><a class="btn" href="/">Volver al inicio</a></p>
  </section>
</Base>
